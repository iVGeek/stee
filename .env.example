# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
# Public URL of the deployed site (used for callback + links)
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
# Port is set automatically by Render; defaults to 3000 locally.
# PORT=3000

# ------------------------------------------------------------------
# Paystack (https://dashboard.paystack.com/#/settings/developers)
# ------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# SMTP email (e.g. Gmail app password, Zoho, Mailtrap for testing)
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Kizito Moraa Counselling <you@gmail.com>"
# Where booking confirmations, feedback and contact messages go
ADMIN_EMAIL=you@gmail.com

# ------------------------------------------------------------------
# WhatsApp (international format, digits only, no "+" or spaces)
# ------------------------------------------------------------------
WA_NUMBER=2547000000000

# ------------------------------------------------------------------
# Feedback moderation token (protects the admin approval endpoints)
# ------------------------------------------------------------------
ADMIN_TOKEN=replace-with-a-long-random-string

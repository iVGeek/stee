{
  "name": "stee-counselling",
  "version": "1.0.0",
  "description": "Modern counselling psychologist website — session booking, Paystack payments, client feedback, email & WhatsApp integration.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "esbuild public/app.ts --bundle --outfile=public/assets/app.js --sourcemap --watch",
    "dev": "concurrently -k -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "build": "esbuild public/app.ts --bundle --minify --outfile=public/assets/app.js && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "concurrently": "^9.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
